+function At58X-RejectProofs($portfolio){
+ # Fail closed for partial goals, missing broker identity, unresolved quantities,
+ # in a rejected goal. Unrelated active goals keep their normal management path.
+ $goals=At58-Value $portfolio 'Goals'
+ $rejected=@($goals|Where-Object {$_.State -ceq 'REJECTED'})
+ if(!$rejected.Count){return @()}
+ $proofs=New-Object 'Collections.Generic.List[string]'
+ foreach($g in $rejected){
+  if($g.Id -cnotmatch '^[a-f0-9]{64}$' -or $null -eq (At58-Value $g 'Filled') -or $g.Filled -ne 0 -or $null -eq (At58-Value $g 'Amount') -or $g.Amount -ne 0){return @()}
+  $nodes=@($g.Nodes);if(!$nodes.Count){return @()}
+  $evidence=New-Object 'Collections.Generic.List[object]'
+  foreach($o in $nodes){
+   if($o.Action -cne 'NEW' -or $o.State -cne 'REJECTED' -or $o.Key -cnotmatch '^[a-f0-9]{64}$' -or $o.RootKey -cne $o.Key -or $o.BrokerId -cnotmatch '^[0-9]{1,11}$' -or $o.Intent.GoalId -cne $g.Id -or (At58-Value $o 'Issue')){return @()}
+   foreach($field in @('Filled','Amount','Remaining')){if($null -eq (At58-Value $o $field) -or $o.$field -ne 0){return @()}}
+   $evidence.Add([ordered]@{Key=$o.Key;Day=$o.Day;BrokerId=$o.BrokerId;Intent=$o.Intent;State=$o.State;Filled=$o.Filled;Amount=$o.Amount;Remaining=$o.Remaining})
+  }
+  $proofs.Add((At58-Hash ('AT58-REJECT-ACK-1|'+$g.Id+'|'+($evidence.ToArray()|ConvertTo-Json -Depth 12 -Compress))))
+ }
+ return $proofs.ToArray()
+}
